generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

// Auth tables
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 1. Kapcsolattartók (Vezetők / Szervezők)
model Contact {
  id                Int                 @id @default(autoincrement())
  createdAt         DateTime            @default(now())
  name              String
  tel               String?
  ordering          Int                 @default(0)
  
  // Kapcsolatok
  roleId            Int?
  role              Role?               @relation(fields: [roleId], references: [id])
  leaders           Leader[]
  organizerTasks    OrganizerTask[]
}

// ÚJ: Szerepkörök tábla
model Role {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  contacts  Contact[]
}

// 2. Mit hozz magaddal lista
model Bring {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  title     String
}

// 3. Napi programbontás
model Program {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now())
  startDay        DateTime
  endDay          DateTime
  startTimeOffset Int
  endTimeOffset   Int
  title           String
  desc            String?
}

// 4. Információs kártyák
model Info {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  title     String
  icon      String
  content   String   @db.Text
  map       Map?
  
  media     Media[]
}

model Media {
  id        Int      @id @default(autoincrement())
  url       String
  type      MediaType // ENUM vagy String (IMAGE / FILE)
  infoId    Int
  info      Info     @relation(fields: [infoId], references: [id], onDelete: Cascade)
}

enum MediaType {
  IMAGE
  FILE
}

// 5. Térkép koordináták
model Map {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  title     String
  lat       Float
  lng       Float
  zoom      Int      @default(15)
  infoId    Int      @unique
  info      Info     @relation(fields: [infoId], references: [id], onDelete: Cascade)
}

// 6. Csapatok
model Team {
  id          Int          @id @default(autoincrement())
  createdAt   DateTime     @default(now())
  name        String
  camperTasks CamperTask[] // Átnevezve
  leaders     Leader[]
  campers     Camper[]     // ÚJ: Résztvevők
}

// ÚJ: Résztvevők (Campers)
model Camper {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  name      String
  email     String?  @unique
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// 7. Tevékenység típusok (Átnevezve camper_activity-re)
model CamperActivity {
  id          Int          @id @default(autoincrement())
  createdAt   DateTime     @default(now())
  title       String
  camperTasks CamperTask[]
}

// 8. Feladatok/Beosztás (Átnevezve camper_task-ra)
model CamperTask {
  id              Int            @id @default(autoincrement())
  createdAt       DateTime       @default(now())
  day             DateTime 
  timeOffset      Int      
  teamId          Int
  team            Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  camperActivityId Int
  camperActivity  CamperActivity @relation(fields: [camperActivityId], references: [id], onDelete: Cascade)
}

// ÚJ: Szervezői tevékenységek
model OrganizerActivity {
  id             Int             @id @default(autoincrement())
  createdAt      DateTime        @default(now())
  title          String
  organizerTasks OrganizerTask[]
}

// ÚJ: Szervezői feladatok (Contact + Activity + Időpont)
model OrganizerTask {
  id                  Int               @id @default(autoincrement())
  createdAt           DateTime          @default(now())
  day                 DateTime
  timeOffset          Int
  contactId           Int
  contact             Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organizerActivityId Int
  organizerActivity   OrganizerActivity @relation(fields: [organizerActivityId], references: [id], onDelete: Cascade)
}

// 11. Fontos határidők
model Deadline {
  id    Int      @id @default(autoincrement())
  label String
  date  DateTime
}

// 10. Globális beállítások
model Setting {
  id      Int    @id @default(autoincrement())
  str_id  String @unique
  label   String
  value   String @default("")
  comment String @default("")
}

// 9. Vezetők rendelése csapatokhoz
model Leader {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  contactId Int
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}